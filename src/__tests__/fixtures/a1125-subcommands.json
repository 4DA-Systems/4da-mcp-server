  "audit": {
    "npm explore": "runs the words after -- as a shell command in the package folder: removed from NO_PACKAGE_SUBCOMMANDS; read by runnerProgram",
    "npm run-script / start / test / restart / stop": "pass their words to a project script: kept, a stated limit (L2, scripts)",
    "npm rebuild": "an operand selects which installed package to rebuild; nothing is fetched: kept",
    "npm dedupe": "re-resolves within the declared ranges, no operand chooses a release: kept (advised)",
    "npm prune": "removes extraneous packages: kept",
    "npm ci / install-ci-test": "install from the lockfile; operands are ignored: kept",
    "npm link": "not on NO_PACKAGE_SUBCOMMANDS: it is on VERBS, read by the link reader",
    "npm diff": "fetches two releases to compare files, installs nothing: kept",
    "pnpm rebuild": "rebuilds installed packages: kept",
    "pnpm deploy": "installs a workspace package from the lockfile into a folder, no operand chooses a release: kept",
    "pnpm import / fetch": "write or prefetch from an existing lockfile: kept",
    "pnpm install-test": "install from the manifest and lockfile, then the test script: kept",
    "yarn import": "writes the lockfile from node_modules: kept",
    "yarn upgrade-interactive": "interactive, no operand: kept (advised)",
    "yarn policies": "`policies set-version` fetches a Yarn release and writes yarnPath (as `yarn set version`, held): removed",
    "yarn exec / run, bun exec / run": "runners: moved from NO_PACKAGE_SUBCOMMANDS to SUBCOMMAND_PATHS \"*\" (runnerProgram reads what they run)",
    "bun remove": "removes a dependency: kept",
    "bun init": "adds the dev dependencies Bun chooses: kept, a stated limit (L1)",
    "cargo run / test / build / bench / check": "fetch what the lockfile and manifest say: kept (advised)",
    "go tool": "runs a tool go.mod declares, fetched as go.mod says: kept",
    "go generate": "runs the //go:generate commands in the source files: kept, a stated limit (L2, scripts)",
    "go list -m x@v": "looks a version up, installs nothing: kept",
    "uv build": "fetches the build requirements the project declares: kept"
  }
}
