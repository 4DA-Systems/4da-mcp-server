{
  "name": "@4da/mcp-server",
  "version": "6.0.2",
  "mcpName": "io.github.4DA-Systems/4da-mcp-server",
  "description": "Upgrade intelligence for AI coding agents: what changes between your installed and target version (changelog, breaking changes, the files you import it from), a pre-install verdict on each bump, vulnerability scanning at osv-scanner parity across npm/pnpm/yarn, Cargo, Python and Go lockfiles, ranked upgrade plans, task-scoped briefings, decision memory. Local, no account; works standalone, and reads the 4DA desktop app's scored feed when it is installed.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server": "dist/index.js",
    "4da-mcp": "dist/index.js",
    "4da-mcp-setup": "dist/setup.js"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/test-setup.*",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "setup": "node dist/setup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "check": "node scripts/check-repo.mjs",
    "contract": "node scripts/app-schema-contract.mjs",
    "contract:sync": "node scripts/sync-app-schema.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "windsurf",
    "copilot",
    "vscode",
    "ai-agent",
    "ai-coding",
    "developer-tools",
    "dependencies",
    "dependency-upgrade",
    "upgrade",
    "changelog",
    "breaking-changes",
    "vulnerability",
    "vulnerability-scanner",
    "security",
    "cve",
    "osv",
    "supply-chain",
    "lockfile",
    "npm",
    "cargo",
    "pypi",
    "go-modules",
    "decision-memory",
    "agent-memory",
    "privacy-first",
    "local-first",
    "offline"
  ],
  "author": "4DA",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4DA-Systems/4da-mcp-server.git"
  },
  "homepage": "https://4da.ai/mcp/",
  "bugs": {
    "url": "https://github.com/4DA-Systems/4da-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.13.12",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "~7.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.6"
}
